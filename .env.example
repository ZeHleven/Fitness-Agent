DATABASE_URL=postgresql+asyncpg://fitness:fitness_pass@postgres:5432/fitness_db
REDIS_URL=redis://redis:6379
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# 微信小程序登录。AppSecret 只能配置在后端，不能写入 miniapp。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_TIMEOUT_SECONDS=5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
AGENT_ENABLED=true
AGENT_MODEL=deepseek-v4-flash
AGENT_TIMEOUT_SECONDS=60
AGENT_INTENT_MODEL_ENABLED=true
AGENT_INTENT_MODEL=deepseek-v4-flash
AGENT_INTENT_TIMEOUT_SECONDS=15
AGENT_INTENT_MAX_TOKENS=1100
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_RECURSION_LIMIT=8
AGENT_ASYNC_WORKER_ENABLED=true
AGENT_WORKER_POLL_SECONDS=0.5
AGENT_RUN_LEASE_SECONDS=180
AGENT_RUN_MAX_ATTEMPTS=3

# 云托管首次部署含新迁移时设为 true；迁移完成后的下一版本改为 false。
RUN_DB_MIGRATIONS_ON_STARTUP=true

# RAG is optional. Configure an OpenAI-compatible embeddings endpoint before enabling.
RAG_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=2048

POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_pass
POSTGRES_DB=fitness_db
